# ── Firebase (PRD Section 12) ─────────────────────────────
# Create a project at https://console.firebase.google.com, then grab these
# from Project settings → General → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# ── Firebase Admin SDK (server-side; Phase 2+; PRD Section 5.3) ──
# Paste the entire service-account JSON as a single line (for local dev).
# On Vercel/GCP this is optional — Application Default Credentials are used automatically.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ── Cloudinary (image storage; Phase 4; free 25 GB, no credit card) ──
# Sign up at https://cloudinary.com, then grab these from the dashboard.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ── App URLs ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Anthropic Claude Haiku ──────────────────────────────
# Get key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key
LLM_MODEL=claude-haiku-4-5


# ── Image Generation (Phase 4; PRD Section 5.2) ───────────
# Hugging Face Inference Providers requires a FINE-GRAINED token with the
# "Make calls to Inference Providers" permission enabled (a plain Read token
# returns 403). Create one at https://huggingface.co/settings/tokens
HUGGING_FACE_API_KEY=your_huggingface_api_key
REPLICATE_API_TOKEN=your_replicate_api_token

# ── Environment ───────────────────────────────────────────
ENVIRONMENT=development
